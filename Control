from pathlib import Path

from PIL import Image

import io, base64, re

src = Path("/mnt/data/CT_Cumberland_Control_Total_v4_BILINGUAL.html")

html = src.read_text(encoding="utf-8")

def compress_data_uri(path, max_width=900, quality=68):

    im = Image.open(path).convert("RGB")

    if im.width > max_width:

        h = round(im.height * max_width / im.width)

        im = im.resize((max_width, h), Image.Resampling.LANCZOS)

    buf = io.BytesIO()

    im.save(buf, format="JPEG", quality=quality, optimize=True, progressive=True)

    return "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode("ascii"), len(buf.getvalue())

es_uri, es_bytes = compress_data_uri(Path("/mnt/data/C1BC027E-F7CC-4033-BCB7-EF3EBE9BA549.jpeg"))

en_uri, en_bytes = compress_data_uri(Path("/mnt/data/a_high_detail_app_ui_screenshot_of_a_fuel_tank_man.png"))

# Replace embedded screen image and bilingual constants with compressed JPEG data URIs.

html = re.sub(r'<img id="mainScreen" class="screen-img" src="data:image/jpeg;base64,[^"]+" alt="CT Cumberland">',

              f'<img id="mainScreen" class="screen-img" src="{es_uri}" alt="CT Cumberland">', html, count=1)

html = re.sub(r"const ES_SCREEN='data:image/jpeg;base64,[^']+';", f"const ES_SCREEN='{es_uri}';", html, count=1)

html = re.sub(r"const EN_SCREEN='data:image/png;base64,[^']+';", f"const EN_SCREEN='{en_uri}';", html, count=1)

# Add GitHub Pages friendly title and no external dependencies.

html = html.replace("<title>CT Cumberland - Control Total</title>", "<title>CT Cumberland | Fuel Control</title>")

out = Path("/mnt/data/index_github_single.html")

out.write_text(html, encoding="utf-8")

print(f"Spanish image: {es_bytes/1024:.1f} KB")

print(f"English image: {en_bytes/1024:.1f} KB")

print(f"Final index: {out.stat().st_size/1024:.1f} KB")

print(out)
