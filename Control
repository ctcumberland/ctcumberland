from pathlib import Path

import base64, re

src = Path("/mnt/data/CT_Cumberland_Control_Total_v3.html")

html = src.read_text(encoding="utf-8")

es_img = Path("/mnt/data/C1BC027E-F7CC-4033-BCB7-EF3EBE9BA549.jpeg")

en_img = Path("/mnt/data/a_high_detail_app_ui_screenshot_of_a_fuel_tank_man.png")

es_b64 = base64.b64encode(es_img.read_bytes()).decode("ascii")

en_b64 = base64.b64encode(en_img.read_bytes()).decode("ascii")

# Upgrade key

html = html.replace("const KEY='ctc_control_total_v3';", "const KEY='ctc_control_total_v4';")

# Replace image with switchable image element.

html = re.sub(

    r'<img class="screen-img" src="data:image/jpeg;base64,[^"]+" alt="CT Cumberland Torre LT-458921">',

    f'<img id="mainScreen" class="screen-img" src="data:image/jpeg;base64,{es_b64}" alt="CT Cumberland">',

    html,

    count=1

)

# Add language selector CSS before </style>

lang_css = r"""

.lang-switch{

  position:fixed;top:max(10px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);

  z-index:95;background:#fff;border:1px solid #dfe6ee;border-radius:999px;padding:3px;

  display:flex;gap:2px;box-shadow:0 4px 14px rgba(15,23,42,.12)

}

.lang-switch button{border:0;background:transparent;border-radius:999px;padding:6px 11px;font-size:11px;font-weight:800;color:#667085}

.lang-switch button.active{background:#0b4db5;color:#fff}

"""

html = html.replace("</style>", lang_css + "\n</style>", 1)

# Add selector after body

selector = r"""

<div class="lang-switch">

  <button id="langES" onclick="setLanguage('es')">ES</button>

  <button id="langEN" onclick="setLanguage('en')">EN</button>

</div>

"""

html = html.replace("<body>", "<body>\n"+selector, 1)

# Insert bilingual JS immediately after <script>

i18n_js = f"""

