'La cantidad supera el inventario disponible de DEF.':'The amount exceeds available DEF inventory.',

'Indica ubicación y descripción.':'Enter location and description.','Describe el daño.':'Describe the damage.',

'Indica el serial nuevo.':'Enter the new serial.','Daño registrado.':'Damage registered.',

'Ubicación actualizada.':'Location updated.','Unidad actualizada.':'Unit updated.',

'Reemplazo registrado y nueva unidad creada.':'Replacement registered and new unit created.',

'Torre de luz':'Light Tower','Generador grande':'Large Generator'

}};

function tr(s){{

 if(appLang==='es'||s==null)return s;

 let out=String(s);

 Object.keys(DICT).sort((a,b)=>b.length-a.length).forEach(k=>{{out=out.split(k).join(DICT[k])}});

 return out;

}}

function trHtml(s){{return appLang==='es'?s:tr(s)}}

function applyLanguage(){{

 document.documentElement.lang=appLang;

 const esBtn=document.getElementById('langES'),enBtn=document.getElementById('langEN');

 if(esBtn)esBtn.classList.toggle('active',appLang==='es');

 if(enBtn)enBtn.classList.toggle('active',appLang==='en');

 const img=document.getElementById('mainScreen');

 if(img)img.src=appLang==='es'?ES_SCREEN:EN_SCREEN;

}}

function setLanguage(lang){{

 appLang=lang;localStorage.setItem(LANG_KEY,lang);applyLanguage();

 closeModal();

}}

const nativeAlert=window.alert.bind(window);

window.alert=(msg)=>nativeAlert(tr(msg));

const nativeConfirm=window.confirm.bind(window);

window.confirm=(msg)=>nativeConfirm(tr(msg));

"""

html = html.replace("<script>", "<script>\n"+i18n_js, 1)

# Modify show() to translate.

html = html.replace(

"function show(title,html){document.getElementById('title').textContent=title;document.getElementById('body').innerHTML=html;document.getElementById('modal').classList.add('show')}",

"function show(title,html){document.getElementById('title').textContent=tr(title);document.getElementById('body').innerHTML=trHtml(html);document.getElementById('modal').classList.add('show')}",

1

)

# Translate notification strings and generated print titles by replacing literal strings in the source.

replacements = {

"'CT Cumberland - Próximo surtido'":"(appLang==='es'?'CT Cumberland - Próximo surtido':'CT Cumberland - Next Refuel')",

"'CT Cumberland - Reporte de cierre'":"(appLang==='es'?'CT Cumberland - Reporte de cierre':'CT Cumberland - Closing Report')",

"body:'Reporte de combustible, torres y tanques disponible para las 4:00 PM.'":"body:tr('Reporte de combustible, torres y tanques disponible para las 4:00 PM.')",

}

for a,b in replacements.items():

    html = html.replace(a,b)

# Add missing dictionary phrase

html = html.replace(

"'Torre de luz':'Light Tower','Generador grande':'Large Generator'",

"'Reporte de combustible, torres y tanques disponible para las 4:00 PM.':'Fuel, tower, and tank closing report is available for 4:00 PM.','Torre de luz':'Light Tower','Generador grande':'Large Generator'"

)

# Ensure language applied at startup.

html = html.replace("setInterval(checkAlerts,60*60*1000);", "setInterval(checkAlerts,60*60*1000);\napplyLanguage();", 1)

out = Path("/mnt/data/CT_Cumberland_Control_Total_v4_BILINGUAL.html")

out.write_text(html, encoding="utf-8")

print(out)

print(f"Tamaño: {out.stat().st_size/1024:.1f} KB")
